{
  "group_by": [
    "grafana_folder",
    "alertname"
  ],
  "receiver": "grafana-default-email",
  "routes": [
    {
      "group_by": [
        "alertname",
        "grafana_folder"
      ],
      "group_interval": "5m",
      "group_wait": "30s",
      "object_matchers": [
        [
          "project",
          "=",
          "studyclub"
        ]
      ],
      "receiver": "discord-studyclub",
      "repeat_interval": "4h"
    }
  ]
}
