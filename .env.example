# StudyClub++ 개발 env — 이 파일 하나로 docker compose · 로컬 backend · 로컬 frontend 가 전부 돈다.
#
#   cp .env.example .env          # 복사 후 아래 「담당자에게 받을 값」만 채운다
#
# 누가 이 파일을 읽나
#   - docker compose        : 자동으로 읽는다 (${VAR} 치환 + discord env_file)
#   - 로컬 backend (bootRun) : cd backend && set -a && source ../.env && set +a && ./gradlew :api:bootRun
#   - 로컬 frontend (npm)    : 앱 폴더의 .env.local 이 이 파일을 가리키는 심링크여야 한다 (ONBOARDING.md §로컬)
#
# ⚠️ PUBLIC 레포 — 이 파일에는 로컬 더미값만 둔다. 실제 값은 .env(gitignore)에만.
#    시크릿을 커밋·이슈·PR·공개 채널에 붙여넣지 않는다. 필요하면 담당자에게 DM 으로 받는다.
#    담당자: @titaniper (GitHub) — 구글 OAuth · SES · 운영 값 전부

# ─── MySQL (로컬 docker 전용 더미) ───────────────────────────────────────────
MYSQL_ROOT_PASSWORD=studyclub_root_local
MYSQL_DATABASE=studyclub
MYSQL_USER=studyclub
MYSQL_PASSWORD=studyclub_local
MYSQL_PORT=23310

# ─── API ─────────────────────────────────────────────────────────────────────
# compose 의 api 가 호스트에 여는 포트. 로컬 bootRun 은 8080 으로 뜬다.
API_PORT=28080
# JWT 서명키 (로컬 더미 — 운영은 내부 시크릿 SSOT 에서 주입)
JWT_SECRET=local-dev-jwt-secret-change-me

# ─── Google OAuth — 🔑 담당자에게 받을 값 ─────────────────────────────────────
# CLIENT_ID / SECRET 은 담당자(@titaniper)에게 DM 으로 요청한다. 비워도 부팅은 되고 로그인 버튼만 막힌다.
# REDIRECT_URI 는 GCP 에 등록된 로컬 콜백이다 — 바꾸면 redirect_uri_mismatch 로 로그인이 깨진다.
# (back-office :4701 도 이 콜백을 재사용한다 — 팝업이 code 를 opener 로 postMessage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4700/api/auth/callback

# ─── Frontend ────────────────────────────────────────────────────────────────
# 포트는 바꾸지 않는다 — 구글 콜백(:4700)과 백엔드 CORS 기본값(:4700, :4701)이 이 번호에 묶여 있다.
CORE_FRONT_PORT=4700
BO_FRONT_PORT=4701
PLAYGROUND_PORT=4702
# 로컬 npm run dev 가 붙을 API. compose 안의 frontend 는 이 값을 무시하고 내부 주소(http://api:8080)를 쓴다.
API_BASE_URL=http://localhost:28080
NEXT_PUBLIC_API_BASE_URL=http://localhost:28080

# 화면이 API 를 직접 부른다(중계 라우트 없음). 그래서 로그인 쿠키가 API 도메인까지 닿아야 한다.
# 로컬은 host 가 localhost 로 같아서 비워 둔다 — 포트가 달라도 쿠키는 전달된다.
# 배포에서만 프론트와 API 의 공통 상위 도메인을 넣는다 (예: .studyclub-plusplus.com).
# 넓힐수록 이 쿠키가 통하는 서브도메인이 늘어난다 — 필요한 만큼만.
AUTH_COOKIE_DOMAIN=
# Next 는 NEXT_PUBLIC_ 만 브라우저에 보낸다 — 위 구글 값을 그대로 넘긴다 (compose·bash·Next 모두 ${} 치환 지원)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
NEXT_PUBLIC_OAUTH_REDIRECT_URI=${GOOGLE_REDIRECT_URI}

# ─── (선택) 로컬 frontend 를 운영 API 에 붙이기 ────────────────────────────────
# 백엔드를 안 띄우고 화면만 볼 때. 위 Frontend 블록의 네 줄을 아래로 바꾼다.
# 콜백은 운영 페이지가 받아 code 를 localhost 로그인 창으로 postMessage 해 준다 (운영 API 가 운영 콜백으로 교환하기 때문).
# ⚠️ 운영 데이터다 — 쓰기 동작(신청·등록)은 실제로 반영된다.
# API_BASE_URL=https://api.studyclub-plusplus.com
# NEXT_PUBLIC_API_BASE_URL=https://api.studyclub-plusplus.com
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=https://studyclub-plusplus.com/api/auth/callback
# stage API 는 외부 주소가 없다 (클러스터 내부 전용) — stage 로 확인할 일은 담당자에게 문의.

# ─── 알림 메일 (SES, notify 카테고리 — 웰컴메일 등) — 🔑 담당자에게 받을 값 ──────
# 비워도 부팅된다 (발송만 안 됨). auth/news/order/cs 카테고리는 아직 쓰는 코드가 없어 여기 안 둔다.
MAIL_NOTIFY_CONFIGURATION_SET_NAME=
MAIL_NOTIFY_REGION=
MAIL_NOTIFY_SUB_DOMAIN=
MAIL_NOTIFY_FROM_ADDRESS=
MAIL_NOTIFY_ACCESS_KEY_ID=
MAIL_NOTIFY_SECRET_ACCESS_KEY=

# ─── Discord 봇 — 🔑 담당자에게 받을 값 ───────────────────────────────────────
# 비워도 봇 API(:24800)는 뜬다. 봇 로그인은 안 됨.
DISCORD_TOKEN=
DISCORD_PORT=24800
# 봇이 ping 을 올릴 채널 ID (비우면 /api/v1/ping 이 409). 바꾼 뒤엔 컨테이너 재생성 필요.
DISCORD_BOT_OUTPUT_CHANNEL=
DISCORD_GUILD_ID=
DISCORD_CAPTAIN_ROLE_ID=
DISCORD_NAVIGATOR_ROLE_ID=
# 백엔드가 Discord 서비스를 부를 때 보내는 X-API-Key
DISCORD_API_KEY=

# ─── 로그 (관측) ─────────────────────────────────────────────────────────────
# 비우면 콘솔 텍스트. 구조화 로그를 보려면 ecs 를 넣는다 (운영 k8s 는 항상 ecs).
# Grafana/Loki/Alloy 는 이 레포가 아니라 인프라 레포(terraform)가 띄운다.
# 조회 주소는 인프라 담당자에게 요청. 설계는 docs/observability-host-setup.md
LOG_JSON_CONSOLE=
