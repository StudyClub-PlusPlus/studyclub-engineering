# StudyClub++ 로컬 개발 env 예시 — 복사해서 .env 로 쓰세요:  cp .env.example .env
# ⚠️ PUBLIC 레포 — 실제 값(구글 시크릿·운영 비밀번호)은 .env(gitignore)에만. 여기엔 로컬 더미만.

# --- MySQL (로컬 docker 전용 더미) ---
MYSQL_ROOT_PASSWORD=studyclub_root_local
MYSQL_DATABASE=studyclub
MYSQL_USER=studyclub
MYSQL_PASSWORD=studyclub_local
MYSQL_PORT=23310

# --- API ---
API_PORT=28080
# 백오피스 접근 allowlist (콤마 구분, 대소문자 무시)
BACK_OFFICE_ALLOWED_EMAILS=karjyk@gmail.com
# JWT 서명키 (로컬 더미 — 운영은 fleet/secret/ 에서 주입)
JWT_SECRET=local-dev-jwt-secret-change-me

# --- Google OAuth (GCP 콘솔에서 클라이언트 생성 후 채움; 그 전엔 비워도 부팅됨) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:24700/api/auth/callback

# --- Frontend ---
CORE_FRONT_PORT=24700
BO_FRONT_PORT=24701
NEXT_PUBLIC_API_BASE_URL=http://localhost:28080

# --- Discord (leave DISCORD_TOKEN empty if you only want discord bot api) ---
DISCORD_TOKEN=
DISCORD_PORT=24800
# 봇이 ping 을 올릴 채널 ID (비우면 /api/v1/ping 이 409). 바꾼 뒤엔 컨테이너 재생성 필요.
DISCORD_BOT_OUTPUT_CHANNEL=

# --- 관측 스택 (Grafana / Loki / Prometheus / Alloy) ---
# 단계별로 올린다 — docs/observability-host-setup.md "이 PR 이 올리는 것" 참조.
#   이번(로그)       GRAFANA_ADMIN_PASSWORD 만 있으면 뜬다. 외부 공개 시 아래 구글 값들 추가.
#   후속(메트릭)     + DISCORD_WEBHOOK_URL
#   후속(서비스지표)  + MYSQL_DATABASE · GRAFANA_DB_USER · GRAFANA_DB_PASSWORD
# Grafana 가 자기 자신을 가리키는 절대 URL. OAuth 리다이렉트가 이걸 쓴다.
GRAFANA_ROOT_URL=http://localhost:3000
# 비워둔다. compose 가 빈 값을 거부하므로(:? 가드) 로컬에서도 한 번은 직접 채워야 한다.
# 로컬이면 아무 값이나, 운영이면 openssl rand -base64 32.
GRAFANA_ADMIN_PASSWORD=

# 구글 로그인 스위치. 기본 꺼짐 — 첫 배포는 SSH 터널(ssh -L 3000:127.0.0.1:3000)로 확인하면
# 되고, 그때는 GCP 콘솔·DNS·인증서가 필요 없다.
# ⚠️ 서브도메인을 인터넷에 열기 전에 반드시 true 로 켜고, 허용되지 않은 계정이 실제로
#    거부되는 것을 눈으로 확인한다. Grafana 는 모든 애플리케이션 로그를 들고 있다.
GRAFANA_GOOGLE_ENABLED=
# Grafana 가 서비스 지표를 읽을 때 쓰는 DB 계정 — 후속 PR 용. 반드시 읽기 전용으로 만든다.
#   CREATE USER 'grafana_ro'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON studyclub.* TO 'grafana_ro'@'%';
GRAFANA_DB_USER=grafana_ro
# GRAFANA_ADMIN_PASSWORD 와 같은 이유로 비워둔다 — 문서가 `cp .env.example .env` 를 안내하므로
# 여기 적힌 기본값은 그대로 살아있는 자격증명이 된다.
GRAFANA_DB_PASSWORD=
# Discord 알림 웹훅 — 후속(메트릭) PR 에서 쓴다. 운영 값은 호스트 .env 에만.
DISCORD_WEBHOOK_URL=
# Grafana 접근 허용 이메일. compose 의 dotenv 파서가 바깥 따옴표를 벗겨내므로, JMESPath
# 리터럴로 쓸 작은따옴표를 보존하려면 전체를 큰따옴표로 한 번 더 감싸야 한다 — 작은따옴표만
# 쓰면 콤마가 있을 때 dotenv 파싱 자체가 실패해 스택이 안 뜨고(예: 아래처럼 큰따옴표 없이
# 쓰면 에러), 이메일이 1개뿐이면 뜨긴 해도 따옴표가 사라져 표현식이 항상 거부로 깨진다
# (fail-closed 라 안전하지만 허용자도 못 들어온다). 실측 확인된 형식:
#   예: GRAFANA_ALLOWED_EMAILS="'someone@example.com','other@example.com'"
GRAFANA_ALLOWED_EMAILS=
