{
  "name": "@studyclub/design",
  "version": "1.0.0",
  "private": true,
  "description": "StudyClub++ 디자인 시스템 v1.0 — 사용자 사이트 + 운영자 콘솔 공용 토큰 (Tailwind v4 CSS-first)",
  "exports": {
    "./tokens.css":           { "style": "./tokens.css",  "default": "./tokens.css"  },
