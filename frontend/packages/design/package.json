    "./base.css":             { "style": "./base.css",    "default": "./base.css"    },
    "./core.css":             { "style": "./core.css",    "default": "./core.css"    },
    "./console.css":          { "style": "./console.css", "default": "./console.css" },
    "./console.overrides.css":{ "style": "./console.css", "default": "./console.css" },
