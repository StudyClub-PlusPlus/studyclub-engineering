{
  "name": "studyclub-engineering",
  "version": "0.0.1",
  "private": true,
  "description": "StudyClub++ 코드 모노레포 (public) — core-front / back-office-front",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:core-front": "pnpm --filter core-front run dev",
    "dev:back-office-front": "pnpm --filter back-office-front run dev",
    "dev:playground": "pnpm --filter playground run dev",
    "dev:storybook": "pnpm --filter @studyclub/ui run storybook",
    "storybook": "pnpm --filter @studyclub/ui run storybook",
    "build-storybook": "pnpm --filter @studyclub/ui run build-storybook",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.10.0"
}
