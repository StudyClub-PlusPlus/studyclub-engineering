# 수동 테스트 하니스(discord/tests/manual) 전용 설정.
#   cp .env.example .env    # 같은 폴더에, 그 다음 값 채우기
#
# ⚠️ PUBLIC 레포 — 여기엔 더미만. 실제 값은 .env 에만 넣는다 (discord/.gitignore 가 무시한다).
# 루트 .env 에는 두지 않는다 — 프로덕션 스택(docker-compose)이 읽는 게 아니라 이 하니스만 쓴다.

# --- Discord OAuth2 ---
# Developer Portal 앱의 OAuth2 → Redirects 에 아래 콜백 URL 을 등록해야 한다.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8900/oauth/callback

# --- 호출 대상 ---
# 직접 실행(python -m app.main)은 4800, 도커는 루트 .env 의 DISCORD_PORT(기본 24800).
DISCORD_API_BASE_URL=http://localhost:4800
# 서비스 간 인증 키. 서버에 X-API-Key 가 구현되면 그때 서비스 쪽 값과 같아야 한다.
DISCORD_API_KEY=
